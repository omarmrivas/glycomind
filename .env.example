# Copiar a .env y ajustar. NUNCA commitear .env.
POSTGRES_USER=glycomind
POSTGRES_PASSWORD=glycomind
POSTGRES_DB=glycomind
POSTGRES_PORT=5432

GLYCOMIND_DATABASE_URL=postgresql+psycopg://glycomind:glycomind@localhost:5432/glycomind

# Zona horaria por defecto para interpretar los timestamps locales del CSV de LibreView.
# El export de LibreView NO lleva zona horaria: es hora de pared del dispositivo.
GLYCOMIND_DEFAULT_TIMEZONE=America/Mexico_City

MINIO_ROOT_USER=glycomind
MINIO_ROOT_PASSWORD=glycomind123
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
GRAFANA_PORT=3000
